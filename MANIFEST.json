{
  "$schema": "../scripts/split-manifest.schema.json",
  "name": "C2TypeScript",
  "version": "0.1.0-pre",
  "source_language": "C17",
  "target_language": "TypeScript",
  "description": "Manifest declaring which internal-maintainer files are vendored into this C2TypeScript snapshot.",
  "comment": "Glob patterns supported. Files listed here are copied into C2TypeScript/vendor/ when refreshing the snapshot.",
  "compiler_src": {
    "comment": "v1 default: vendor the full emitter and tolerate unused code paths.",
    "files": [
      "compiler/src/emitter.ts",
      "compiler/src/type-mapper.ts",
      "compiler/src/cptr.ts",
      "compiler/src/posix-shims.ts",
      "compiler/src/inline-asm-patterns.ts",
      "compiler/src/flex-bison-handler.ts",
      "compiler/src/clang-runner.ts",
      "compiler/src/clang-runner-streaming.ts",
      "compiler/src/ast-types.ts",
      "compiler/src/multi-file-resolver.ts",
      "compiler/src/import-resolver.ts",
      "compiler/src/import-resolver-ast.ts",
      "compiler/src/dependency-graph.ts",
      "compiler/src/dependency-resolver.ts",
      "compiler/src/header-scanner.ts",
      "compiler/src/library-scanner.ts",
      "compiler/src/project-scanner.ts",
      "compiler/src/project-builder.ts",
      "compiler/src/project-integrator.ts",
      "compiler/src/comprehensive-flags.ts",
      "compiler/src/build-detector.ts",
      "compiler/src/entry-point-detector.ts",
      "compiler/src/input-detector.ts",
      "compiler/src/source-detector.ts",
      "compiler/src/source-map.ts",
      "compiler/src/cli.ts",
      "compiler/src/iteration-speed.ts",
      "compiler/src/engine-prompt.ts",
      "compiler/src/band-a-detector.ts",
      "compiler/src/band-a-stub-emitter.ts",
      "compiler/src/engine-routing.ts",
      "compiler/src/pre-translation-audit.ts",
      "compiler/src/post-translation-cleanup.ts",
      "compiler/src/shim-database.ts",
      "compiler/src/shim-generator.ts",
      "compiler/src/loop-transformer.ts",
      "compiler/src/rendering-connector.ts",
      "compiler/src/data-path-resolver.ts",
      "compiler/src/preload-generator.ts",
      "compiler/src/binding-extractor.ts",
      "compiler/src/foreign-function-resolver.ts",
      "compiler/src/parallel-translator.ts",
      "compiler/src/pointer-analyzer.ts",
      "compiler/src/posix-audit.ts",
      "compiler/src/progress-reporter.ts",
      "compiler/src/proto-handler.ts",
      "compiler/src/qt-moc-handler.ts",
      "compiler/src/root-cause.ts",
      "compiler/src/source-map.ts",
      "compiler/src/state-comparator.ts",
      "compiler/src/test-generator.ts",
      "compiler/src/test-suite-detector.ts",
      "compiler/src/thread-classifier.ts",
      "compiler/src/trace-capture.ts",
      "compiler/src/trace-diff.ts",
      "compiler/src/tsc-error-classifier.ts",
      "compiler/src/tsc-error-parser.ts",
      "compiler/src/tsc-fixes.ts",
      "compiler/src/tsc-fix-loop.ts",
      "compiler/src/emit-writer.ts",
      "compiler/src/oracle.ts",
      "compiler/src/oracle-comparator.ts",
      "compiler/src/oracle-cpp.ts",
      "compiler/src/verify-translation.ts",
      "compiler/src/fix-applicator.ts",
      "compiler/src/fix-pattern-db.ts",
      "compiler/src/fix-table.ts",
      "compiler/src/self-modifying-loop.ts"
    ]
  },
  "runtime_subprojects": {
    "comment": "v1: vendored. v2: migrate to versioned npm dependencies once API surfaces stabilise. Directory names below are codenames retained for source compatibility; literal descriptions appear in README.md.",
    "include": [
      "basalt/src/**/*.ts",
      "forge/src/**/*.ts",
      "mirage/src/**/*.ts",
      "anchor/src/**/*.ts"
    ],
    "optional": [
      "prism/src/**/*.ts",
      "dossier/src/**/*.ts",
      "nexus/src/**/*.ts",
      "sentinel/src/**/*.ts",
      "twinsight/src/**/*.ts",
      "ember/src/**/*.ts"
    ]
  },
  "exclude": [
    "compiler/src/lua-*.ts",
    "compiler/src/tolua-parser.ts",
    "compiler/src/orbit-*.ts",
    "alloy/**/*",
    "orbit/**/*",
    "crescent/**/*",
    "bridge-lua/**/*"
  ],
  "tests": {
    "comment": "C-cell matrix tests only. Real-world C fixtures (cJSON, sds, xxhash, etc.) are NOT vendored - they would duplicate published ts-* output repositories. To reproduce a real-world translation locally, clone the upstream C source separately and run c2typescript against it. The translated TypeScript output for each demonstrated case is at github.com/ScottMoore0/ts-<name>.",
    "include_globs": [
      "compiler/tests/matrix/c_features/**/*",
      "compiler/tests/oracle/**/*"
    ]
  },
  "examples": {
    "comment": "v1: reference upstream ts-* repos by URL. v2: consider bundling minimal example.",
    "ts_repos_referenced": [
      "https://github.com/ScottMoore0/ts-cJSON",
      "https://github.com/ScottMoore0/ts-antirez-sds",
      "https://github.com/ScottMoore0/ts-tiny-aes",
      "https://github.com/ScottMoore0/ts-xxhash",
      "https://github.com/ScottMoore0/ts-picohttpparser",
      "https://github.com/ScottMoore0/ts-chibi-base64"
    ]
  }
}
