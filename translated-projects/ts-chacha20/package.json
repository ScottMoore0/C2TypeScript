{
  "name": "ts-chacha20",
  "version": "1.0.0",
  "description": "A direct TypeScript port of a minimal ChaCha20 stream cipher (RFC 8439).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/vectors.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["chacha20", "stream-cipher", "rfc8439", "djb", "cryptography", "typescript"],
  "author": "Scott Moore",
  "license": "Unlicense",
  "repository": { "type": "git", "url": "git+https://github.com/ScottMoore0/ts-chacha20.git" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
