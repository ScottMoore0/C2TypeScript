{
  "name": "ts-crc8",
  "version": "1.0.0",
  "description": "TypeScript port of libcrc's CRC-8 (Sensirion SHT75 variant, poly 0x31).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/vectors.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["crc8", "crc-8", "sensirion", "sht", "1-wire", "checksum", "typescript"],
  "author": "Scott Moore",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ScottMoore0/ts-crc8.git" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
