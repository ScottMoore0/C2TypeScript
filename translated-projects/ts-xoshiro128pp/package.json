{
  "name": "ts-xoshiro128pp",
  "version": "1.0.0",
  "description": "TypeScript port of xoshiro128++ by David Blackman and Sebastiano Vigna — fast 32-bit PRNG with 128-bit state.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/vectors.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["xoshiro", "xoshiro128", "prng", "random", "rng", "vigna", "blackman", "typescript"],
  "author": "Scott Moore",
  "license": "Unlicense",
  "repository": { "type": "git", "url": "git+https://github.com/ScottMoore0/ts-xoshiro128pp.git" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
