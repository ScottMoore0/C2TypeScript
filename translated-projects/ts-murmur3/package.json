{
  "name": "ts-murmur3",
  "version": "1.0.0",
  "description": "A zero-dependency TypeScript port of MurmurHash3 by Austin Appleby. Pure-TS, browser-safe, with x86_32 / x86_128 / x64_128 variants.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node tests/vectors.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "murmurhash3",
    "murmur3",
    "hash",
    "non-cryptographic-hash",
    "smhasher",
    "typescript",
    "c-to-ts"
  ],
  "author": "Scott Moore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScottMoore0/ts-murmur3.git"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
