{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": ["../compiler/node_modules/@types", "./node_modules/@types"],
    "types": ["node"],
    "allowJs": true,
    "noEmitOnError": false
  },
  "include": ["src/**/*", "vendor/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "examples",
    "vendor/**/test/**",
    "vendor/**/tests/**",
    "vendor/**/*.test.ts",
    "vendor/**/node_modules/**"
  ]
}
