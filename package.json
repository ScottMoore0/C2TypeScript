{
  "name": "ts-ripemd160",
  "version": "1.0.0",
  "description": "TypeScript port of DaveCTurner/tiny-ripemd160 — RIPEMD-160 cryptographic hash.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
