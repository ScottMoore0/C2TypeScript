{
  "name": "ts-rxi-vec",
  "version": "1.0.0",
  "description": "TypeScript port of rxi/vec, a type-safe dynamic-array C library, with macros pre-instantiated across six element types.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vec",
    "vector",
    "dynamic-array",
    "rxi",
    "typescript",
    "c-port"
  ],
  "author": "Scott Moore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScottMoore0/ts-rxi-vec.git"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
