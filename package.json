{
  "name": "ts-base58",
  "version": "1.0.0",
  "description": "TypeScript port of deemru/b58 — Bitcoin-alphabet Base58 encoding.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
