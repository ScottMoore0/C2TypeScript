    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["base58", "bitcoin", "encoding", "ipfs", "solana", "typescript"],
  "author": "Scott Moore",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ScottMoore0/ts-base58.git" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
