{
  "name": "ts-tiny-regex-c",
  "version": "1.0.1",
  "description": "A zero-dependency TypeScript port of tiny-regex-c by kokke. Small portable regex matcher inspired by Rob Pike.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npx tsx tests/vectors.test.ts"
  },
  "keywords": [
    "regex",
    "regular-expressions",
    "tiny",
    "portable",
    "c-to-ts"
  ],
  "author": "Scott Moore",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScottMoore0/ts-tiny-regex-c.git"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}