{
  "name": "ts-sglib",
  "version": "1.1.0",
  "description": "TypeScript port of SGLIB (Marian Vittek): pre-instantiated LIST, DL_LIST, SORTED_LIST, RBTREE, and HASHED_CONTAINER over fixed element types.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test --experimental-strip-types tests/vectors.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sglib",
    "linked-list",
    "double-linked-list",
    "sorted-list",
    "red-black-tree",
    "hash-table",
    "data-structures",
    "typescript",
    "c-port",
    "c-to-ts"
  ],
  "author": "Scott Moore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScottMoore0/ts-sglib.git"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
