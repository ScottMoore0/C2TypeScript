  "keywords": ["ripemd160", "ripemd-160", "hash", "cryptography", "bitcoin", "typescript"],
  "author": "Scott Moore",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ScottMoore0/ts-ripemd160.git" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
