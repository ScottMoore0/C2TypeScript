{
  "name": "ts-aes-ofb",
  "version": "1.0.0",
  "description": "TypeScript port of WjCryptLib's AES-OFB (NIST SP 800-38A §F.4). AES-128/192/256.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/vectors.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["aes", "aes-ofb", "ofb", "stream-cipher", "fips197", "sp800-38a", "typescript"],
  "author": "Scott Moore",
  "license": "Unlicense",
  "repository": { "type": "git", "url": "git+https://github.com/ScottMoore0/ts-aes-ofb.git" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
