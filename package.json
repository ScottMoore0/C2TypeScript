{
  "name": "ts-md2",
  "version": "1.0.0",
  "description": "A direct TypeScript port of Brad Conte's MD2 reference implementation (RFC 1319).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/vectors.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["md2", "hash", "cryptography", "rfc1319", "typescript", "legacy"],
  "author": "Scott Moore",
  "license": "Unlicense",
  "repository": { "type": "git", "url": "git+https://github.com/ScottMoore0/ts-md2.git" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
