{
  "name": "ts-xxhash",
  "version": "1.0.0",
  "description": "A zero-dependency TypeScript port of xxHash, the extremely fast non-cryptographic hash by Yann Collet. XXH32, XXH64, and XXH3 (64-bit and 128-bit) hashing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-strip-types tests/vectors.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xxhash",
    "hash",
    "non-cryptographic-hash",
    "typescript",
    "c-to-ts"
  ],
  "author": "Scott Moore",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScottMoore0/ts-xxhash.git"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
