{
  "name": "ts-arcfour",
  "version": "1.0.0",
  "description": "A direct TypeScript port of Brad Conte's ARCFOUR (RC4) reference implementation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/vectors.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["arcfour", "rc4", "stream-cipher", "rfc6229", "typescript"],
  "author": "Scott Moore",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScottMoore0/ts-arcfour.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
