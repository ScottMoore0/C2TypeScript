{
  "name": "ts-sha1",
  "version": "1.0.0",
  "description": "A direct TypeScript port of Brad Conte's SHA-1 reference implementation (FIPS 180-4).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/vectors.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["sha1", "sha-1", "hash", "cryptography", "fips180", "rfc3174", "typescript"],
  "author": "Scott Moore",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScottMoore0/ts-sha1.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
